{% extends 'base.html.twig' %}

{% block title %}Cercles - Nous Autres{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/cercles.css') }}">
{% endblock %}

{% block body %}
<div class="cercles-container">
    <h1>Nos Cercles</h1>
    <div class="cercles-grid">
        {% for cercle in cercles %}
            <div class="cercle-card">
                <h2>{{ cercle.nom }}</h2>
                <p>{{ cercle.description }}</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

